# ==============================================================================
# Jarvis AIOps — Open-Source Configuration
# ==============================================================================

# --- Authentication (REQUIRED for HTTP endpoints) ---
JARVIS_AUTH_TOKEN=change-me-use-openssl-rand-hex-32

# --- Language & Timezone ---
# Language selects default prompts: "en" or "pt-BR"
JARVIS_LANGUAGE=en
JARVIS_TZ_OFFSET_HOURS=0
JARVIS_TZ_LABEL=UTC

# --- LLM Providers (configure one or more; Router auto-fallbacks on 429/503/5xx) ---
# Supported model prefixes in JARVIS_MODEL_CHAIN:
#   gemini:<model>     (or bare gemini-*)   -> uses GEMINI_API_KEY / GOOGLE_API_KEY
#   anthropic:<model>  (or bare claude-*)   -> uses ANTHROPIC_API_KEY
#   openai:<model>     (or gpt-*)           -> uses OPENAI_API_KEY + OPENAI_BASE_URL
#   ollama:<model>                          -> uses OLLAMA_BASE_URL (default http://localhost:11434/v1)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional explicit chain (if omitted, built automatically from configured keys)
# JARVIS_MODEL_CHAIN=gemini:gemini-2.5-flash,anthropic:claude-sonnet-4-5,openai:gpt-4o-mini
# JARVIS_CHEAP_MODEL_CHAIN=gemini:gemini-2.5-flash-lite,ollama:qwen2.5:7b
JARVIS_SUMMARIZE_MODEL=
JARVIS_LLM_TIMEOUT_S=120
JARVIS_THINKING_BUDGET_DEFAULT=2048
JARVIS_LLM_SUMMARIZE_ENABLED=1
JARVIS_SUMMARIZE_THRESHOLD_CHARS=6000

# --- Vector Embeddings (SQLite + sqlite-vec) ---
# auto | gemini | openai | disabled
JARVIS_EMBED_PROVIDER=auto
JARVIS_EMBED_MODEL=gemini-embedding-001
JARVIS_EMBED_DIM=768
JARVIS_OPENAI_EMBED_MODEL=text-embedding-3-small
JARVIS_DB_PATH=/app/data/jarvis.db

# --- MCP Servers (Zabbix & SigNoz) ---
# Leave empty to run with only one source or mock in tests
MCP_ZABBIX_URL=http://zabbix-mcp:8081/mcp
# Extra read-only Zabbix tools (comma-separated, merged into default 37 RO tools)
JARVIS_ZABBIX_EXTRA_RO_TOOLS=

# Optional SigNoz MCP (stdio transport)
MCP_SIGNOZ_COMMAND=/usr/local/bin/signoz-mcp-server
SIGNOZ_URL=http://signoz:3301
SIGNOZ_API_KEY=
# Comma-separated services that emit traces only (no logs), e.g. traefik,envoy
JARVIS_TRACES_ONLY_SERVICES=traefik
# Optional JSON mapping {"service-alias": "zabbix-host-name"}
JARVIS_SERVICE_HOST_MAP={}
# Optional regex matching hostnames in natural-language /ask queries
JARVIS_HOST_REGEX=

# --- Keep-style Autonomous Diagnosis Queue (/diagnose) ---
JARVIS_ASYNC_DIAGNOSE_DEADLINE_S=210
JARVIS_ASYNC_DIAGNOSE_MAX_QUEUE=20
JARVIS_ASYNC_DIAGNOSE_COOLDOWN_S=720
JARVIS_ASYNC_DIAGNOSE_DEDUP_S=3600
JARVIS_ASYNC_DEBOUNCE_S=60
JARVIS_ASYNC_GROUP_WINDOW_S=180
JARVIS_DEBOUNCE_EXEMPT_PATTERNS=
JARVIS_AUTO_HOURLY_CAP=12
JARVIS_AUTO_DAILY_CAP=60
JARVIS_AUTO_SOFT_DOWNGRADE_HOURLY=6
JARVIS_MAX_TOOL_ITERATIONS=10
JARVIS_ASK_MAX_ITERATIONS=10
JARVIS_AUTO_MAX_ITERATIONS=6

# --- Telegram Notifications (optional, for /diagnose alerts + inline buttons) ---
JARVIS_TG_TOKEN=
JARVIS_TG_CHAT_ID=

# --- OpenTelemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jarvis-aiops
